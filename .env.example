# TrustVault Environment Configuration Example
# Copy this file to .env and configure secrets prior to deployment

# Security & Secret Management
SECRET_KEY=1*(dd4!-4m0-3$ksswf!iz5hn0_^o*lgd+uah@)!t(!$$gd6-)
DEBUG=False

# Allowed Hosts: Comma-separated domains/IPs
ALLOWED_HOSTS=trustvault.pythonanywhere.com,localhost,127.0.0.1

# Production HTTPS & Security Headers
SECURE_SSL_REDIRECT=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
